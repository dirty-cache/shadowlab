#!/bin/bash

die() { echo "$(basename $0): [die] $@" >&2 ; exit 1 ; }
test -x /usr/sbin/qm || die "qm not found"

vmid=$(qm list | awk '$2=="mgt" {print $1}')

qm set $vmid --ide2=local:iso/Rocky-9.8-x86_64-minimal.iso,media=cdrom
qm disk import "$vmid" /var/lib/vz/import/oemdrv.img.raw local-lvm --target-disk scsi1
qm set "$vmid" --scsi1 local-lvm:vm-"$vmid"-disk-1
