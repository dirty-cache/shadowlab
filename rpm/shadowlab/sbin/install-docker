#!/bin/bash
# ===========================================================================
# Title       : Install Docker on Rocky Linux
# Description : 
# Author      : Bart Sjerps <bart@dirty-cache.com>
# Date        : 2026-08-06
# ---------------------------------------------------------------------------

test -f /etc/yum.repos.d/docker-ce-stable.repo || cp /usr/share/shadowlab/docker-ce-stable.repo /etc/yum.repos.d/docker-ce-stable.repo

dnf -y install docker-ce docker-ce-cli containerd.io docker-compose-plugin
systemctl enable --now docker

mkdir -p /opt/docker
ln -s /var/lib/docker/volumes /volumes

