#!/bin/bash
# ===========================================================================
# Title       : pve-router
# Description : Create a VM on Proxmox for running OPNSense Router
# Author      : Bart Sjerps <bart@dirty-cache.com>
# Date        : 2026-10-28
# ---------------------------------------------------------------------------

die() { echo "$(basename $0): [die] $@" >&2 ; exit 1 ; }
test -x /usr/sbin/qm || die "qm not found (Not a Proxmox host)"

NAME=router
DISK_STORAGE=local-lvm
LAN=vmbr0
WAN=vmbr1
ISO=OPNsense-26.7-dvd-amd64.iso
SCSI0="${DISK_STORAGE}:import-from=local:import/router.qcow2"

usage() {
    cat <<EOF
Usage: $(basename "$0") [-n name] {create|destroy|install|update|configure|cleanup}

Create and set up an OPNsense router VM on this Proxmox host.

Options:
  -n name     VM name (default: router)
  -h          Show this help

Actions:
  create      Next free VMID: 1 core, 1024 MiB, disk imported from
              local:import/basic.qcow2 onto $DISK_STORAGE, virtio NICs on
              $LAN (LAN) and $WAN (WAN), then start
  destroy     Stop and destroy the VM named with -n
  install     Run pve-vmsetup with /usr/local/etc/opn-install.txt
  update      Run pve-vmsetup with /usr/local/etc/opn-update.txt
  configure   Attach local:iso/router.iso and run pve-vmsetup with
              /usr/local/etc/opn-import.txt
  cleanup     Detach the ISO and set 1 core / 1024 MiB
EOF
}

create() {
    vmid=$(pvesh get /cluster/nextid)
    qm create "$vmid" \
    --name "$NAME" \
    --onboot 1 \
    --ostype l26 \
    --machine q35 \
    --agent enabled=1 \
    --cpu host \
    --sockets 1 \
    --cores 1 \
    --memory 1024 \
    --scsihw virtio-scsi-single \
    --scsi0 "${SCSI0}" \
    --ide2 "none,media=cdrom" \
    --boot "order=scsi0" \
    --net0 "virtio,bridge=${LAN}" \
    --net1 "virtio,bridge=${WAN}"

    qm start $vmid
}

destroy() {
    vmid=$(qm list | awk -vname=$NAME '$2==name {print $1}')
    test -z $vmid && die "Unknown VM name"
    qm stop $vmid
    qm destroy $vmid
}

install() {
    vmid=$(qm list | awk -vname=$NAME '$2==name {print $1}')
    test -z $vmid && die "Unknown VM name"
    pve-vmsetup $vmid /usr/local/etc/opn-install.txt
}

update() {
    vmid=$(qm list | awk -vname=$NAME '$2==name {print $1}')
    test -z $vmid && die "Unknown VM name"
    pve-vmsetup $vmid /usr/local/etc/opn-update.txt
    #qm reboot $vmid
}

configure() {
    vmid=$(qm list | awk -vname=$NAME '$2==name {print $1}')
    test -z $vmid && die "Unknown VM name"
    qm set $vmid --ide2 local:iso/router.iso,media=cdrom
    pve-vmsetup $vmid /usr/local/etc/opn-import.txt
}

cleanup() {
    vmid=$(qm list | awk -vname=$NAME '$2==name {print $1}')
    test -z $vmid && die "Unknown VM name"
    qm set $vmid --ide2 none,media=cdrom
    qm set $vmid --memory 1024
    qm set $vmid --cores 1
}

while getopts ":h:n:f" OPT; do
  case "$OPT" in
  f)   SCSI0="${DISK_STORAGE}:8" \
  n)   NAME=$OPTARG ;;
 \?|h) usage ; exit 0 ;;
  esac
done
shift $((OPTIND-1))

action=$1; shift

case $action in
  create)    create ;;
  destroy)   destroy ;;
  install)   install ;;
  update)    update ;;
  configure) configure ;;
  cleanup)   cleanup ;;
  *)         usage ;;
esac
