#!/bin/bash
# ===========================================================================
# Title       : pve-linux
# Description : Create a VM on Proxmox for running Rocky Linux
# Author      : Bart Sjerps <bart@dirty-cache.com>
# Date        : 2026-10-28
# ---------------------------------------------------------------------------

die() { echo "$(basename $0): [die] $@" >&2 ; exit 1 ; }
test -x /usr/sbin/qm || die "qm not found (Not a Proxmox host)"

NAME=linux
DISK_STORAGE=local-lvm
LAN=vmbr0
ISO=Rocky-9.8-x86_64-minimal.iso
KS=clean
AUTO=0

usage() {
    cat <<EOF
Usage: $(basename "$0") [-n name] [-c kickstart] [-a] {create|destroy|cleanup}

Create, destroy, or clean up a Rocky Linux VM on this Proxmox host.

Options:
  -n name        VM name (default: linux)
  -c kickstart   Kickstart image under local:import/ (default: clean,
                 i.e. local:import/clean.img.raw)
  -a             After create, start the VM and send Up+Enter
  -h             Show this help

Actions:
  create         Next free VMID: 2 cores, 4096 MiB, 32 GiB boot disk on
                 local-lvm, kickstart disk, $ISO, virtio NIC on $LAN
  destroy        Stop and destroy the VM named with -n
  cleanup        Detach the ISO and kickstart disk, set 2 cores / 2048 MiB
EOF
}

create() {
    vmid=$(pvesh get /cluster/nextid)
    qm create "$vmid" \
    --name "$NAME" \
    --onboot 1 \
    --ostype l26 \
    --machine q35 \
    --agent enabled=1 \
    --cpu host \
    --sockets 1 \
    --cores 2 \
    --memory 4096 \
    --scsihw virtio-scsi-single \
    --scsi0 "${DISK_STORAGE}:32,serial=boot" \
    --scsi1 "${DISK_STORAGE}:0,import-from=local:import/${KS}.img.raw" \
    --ide2 "local:iso/$ISO,media=cdrom" \
    --boot "order=scsi0;ide2" \
    --net0 "virtio,bridge=${LAN}" \
    --smbios1 "serial=$NAME"

    if [ "$AUTO" = "1" ]; then
        qm start $vmid
        echo Sleeping 10 seconds to allow startup....
        sleep 10
        echo Sending keystrokes...
        qm sendkey $vmid up
        qm sendkey $vmid ret
        echo Done.
    fi
}

destroy() {
    vmid=$(qm list | awk -vname=$NAME '$2==name {print $1}')
    test -z $vmid && die "Unknown VM name"
    qm stop $vmid
    qm destroy $vmid
}

cleanup() {
    vmid=$(qm list | awk -vname=$NAME '$2==name {print $1}')
    test -z $vmid && die "Unknown VM name"
    qm set $vmid --ide2 none,media=cdrom
    qm set $vmid --delete scsi1
    qm set $vmid --memory 2048
    qm set $vmid --cores 2
    qm set $vmid --delete unused0
}

while getopts ":h:c:n:a" OPT; do
  case "$OPT" in
  c)   KS=$OPTARG ;;
  a)   AUTO=1 ;;
  n)   NAME=$OPTARG ;;
 \?|h) usage ; exit 0 ;;
  esac
done
shift $((OPTIND-1))

action=$1; shift

case $action in
  create)    create ;;
  destroy)   destroy ;;
  cleanup)   cleanup ;;
  *)         usage ;;
esac
