#!/bin/bash
# ===========================================================================
# Title       : ip_auto
# Description : Set the default interface to use Fixed IP (manual)
# Author      : Bart Sjerps <bart@dirty-cache.com>
# Date        : 2026-10-23
# ---------------------------------------------------------------------------

NIC=enp6s18
IPADDR=192.168.70.2
GATEWAY=192.168.70.253
DNS=192.168.70.253

serial=$(dmidecode -s system-serial-number)

case $serial in
  docker01) IPADDR=192.168.70.12 ;;
esac

nmcli connection modify $NIC \
	connection.autoconnect yes \
	ipv4.method manual \
	ipv4.addresses ${IPADDR}/24 \
	ipv4.gateway ${GATEWAY} \
	ipv4.dns ${DNS} \
	ipv6.method disabled

nmcli connection show $NIC

