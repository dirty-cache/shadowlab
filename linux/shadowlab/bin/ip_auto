#!/bin/bash
# ===========================================================================
# Title       : ip_auto
# Description : Set the default interface to use DHCP (auto)
# Author      : Bart Sjerps <bart@dirty-cache.com>
# Date        : 2026-10-23
# ---------------------------------------------------------------------------

NIC=enp6s18

nmcli connection modify $NIC \
	connection.autoconnect yes \
	ipv4.method auto \
	ipv4.addresses "" \
	ipv4.gateway "" \
	ipv4.dns "" \
	ipv6.method disabled

nmcli connection show $NIC

