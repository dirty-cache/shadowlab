# Shadow Lab Deployer configuration
# The image is pulled from GitHub Packages:
# https://github.com/dirty-cache/shadowlab/packages
# (ghcr.io/dirty-cache/shadowlab/deployer). It is not built on this host.

# Host port for the web UI
COMPOSE_PORT_HTTP=8080

# Tag published by .github/workflows/deployer-image.yml (latest or a commit SHA)
DEPLOYER_TAG=latest

# Optional: require a token in the browser (stored in localStorage).
# Empty = open access (fine on the isolated lab LAN).
DEPLOYER_TOKEN=

# Dockhand API. The compose file publishes Dockhand on host port 3001.
DOCKHAND_URL=http://192.168.70.2:3001

# Personal API token from the Dockhand profile page (starts with dh_).
DOCKHAND_TOKEN=

# Repository Dockhand clones for git stacks, and that this UI lists.
GIT_REPO_URL=https://github.com/dirty-cache/shadowlab.git
GIT_BRANCH=master

# Read-only token so the UI can list docker/*/compose.yaml on a private repo.
# Classic PAT: contents=read. Fine-grained: Contents read-only on shadowlab.
GITHUB_TOKEN=

# Optional Dockhand git credential id, so Dockhand can clone the private repo.
GIT_CREDENTIAL_ID=
