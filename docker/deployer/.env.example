# Shadow Lab Deployer configuration

# Host port for the web UI
COMPOSE_PORT_HTTP=8080

# Optional: require a token in the browser (stored in localStorage).
# Empty = open access (fine on the isolated lab LAN).
DEPLOYER_TOKEN=

# Directory holding the repo's docker/ stack folders (discovery source).
# Default ../ works when running from a git checkout.
# On the docker VM set it to the checkout's docker dir, e.g.
#   DEPLOYER_PROJECTS_HOST=/root/shadowlab/docker
# so stacks added to the repo are discovered after a git pull.
DEPLOYER_PROJECTS_HOST=../

# Directory with installed stack copies (bin/install-container convention).
# When a stack is installed here, the UI runs it from this copy so its
# .env file (and env_file: entries) resolve like a manual install.
DEPLOYER_INSTALLED_HOST=/opt/docker

# Name + address of the default Docker host, seeded on first start.
# Can be changed or extended later from the UI (Docker hosts panel).
DEPLOYER_DEFAULT_HOST_NAME=lab
DEPLOYER_DEFAULT_DOCKER_HOST=unix:///var/run/docker.sock

# Image tag for the locally built deployer image
DEPLOYER_TAG=dev
