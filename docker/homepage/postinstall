#!/bin/bash

die() { echo "$(basename $0): [die] $@" >&2 ; exit 1 ; }
test -x /usr/bin/dnf || die "Not an RPM based host"

test -d /var/lib/docker/volumes/homepage_config/_data/ || die "Homepage data volume not found"

test -f /var/lib/docker/volumes/homepage_config/_data/settings.yaml || cp -pr /opt/docker/homepage/settings.yaml /var/lib/docker/volumes/homepage_config/_data
test -f /var/lib/docker/volumes/homepage_config/_data/services.yaml || cp -pr /opt/docker/homepage/services.yaml /var/lib/docker/volumes/homepage_config/_data
