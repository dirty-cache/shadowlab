#!/bin/bash
# ===========================================================================
# Title       : download-isos
# Description : Download the ISO images required for Shadowlab install
# Author      : Bart Sjerps <bart@dirty-cache.com>
# Date        : 2026-10-28
# ---------------------------------------------------------------------------

die() { echo "$(basename $0): [die] $@" >&2 ; exit 1 ; }
gitdir=$(git rev-parse --show-toplevel)
set -e

URL_PROXMOX=https://enterprise.proxmox.com/iso/proxmox-ve_9.2-1.iso
URL_OPNSENSE=https://pkg.opnsense.org/releases/26.7/OPNsense-26.7-dvd-amd64.iso.bz2
URL_ROCKY=https://download.rockylinux.org/pub/rocky/9/isos/x86_64/Rocky-9.9-x86_64-minimal.iso

test -d $gitdir/iso || mkdir $gitdir/iso
echo Downloading ISO images...

for URL in $URL_PROXMOX $URL_OPNSENSE $URL_ROCKY; do
    filename=$(basename $URL)
    isoname=${filename%.bz2}
    test -f $gitdir/iso/$isoname || {
        echo "$isoname does not exist, downloading..."
        curl -fL $URL -o $gitdir/iso/$filename || die "Download failed: $URL"
        test -f $gitdir/iso/${filename##.bz2} && bunzip2 $gitdir/iso/$filename
    }
done

ls -al $gitdir/iso
