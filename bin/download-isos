#!/bin/bash
#============================================================================
# Title       : download-isos
# Description : Download the ISO images required for Shadowlab install
# Author      : Bart Sjerps <bart@dirty-cache.com>
# Date        : 2026-10-28
# ---------------------------------------------------------------------------

die() { echo "$(basename $0): [die] $@" >&2 ; exit 1 ; }
gitdir=$(git rev-parse --show-toplevel)

ISO_PROXMOX=proxmox-ve_9.2-1.iso
ISO_OPNSENSE=OPNsense-26.7-dvd-amd64.iso
ISO_ROCKY=Rocky-9.8-x86_64-minimal.iso

test -d $gitdir/iso || mkdir $gitdir/iso

echo Downloading ISO images...

test -f $gitdir/iso/$ISO_PROXMOX  || curl https://enterprise.proxmox.com/iso/$ISO_PROXMOX -o $gitdir/iso/$ISO_PROXMOX
test -f $gitdir/iso/$ISO_OPNSENSE || curl https://pkg.opnsense.org/releases/26.7/${ISO_OPNSENSE}.bz2 -o $gitdir/iso/${ISO_OPNSENSE}.bz2
test -f $gitdir/iso/$ISO_ROCKY    || curl https://download.rockylinux.org/pub/rocky/9/isos/x86_64/$ISO_ROCKY -o $gitdir/iso/$ISO_ROCKY

echo Unpacking OPNSense image...

test -f $gitdir/iso/$ISO_OPNSENSE}.bz2 && bunzip2 $gitdir/iso/${ISO_OPNSENSE}.bz2
