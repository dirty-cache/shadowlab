#!/bin/bash

die() { echo "$(basename $0): [die] $@" >&2 ; exit 1 ; }

gitdir=$(git rev-parse --show-toplevel)
cd $gitdir

tmpdir=$(mktemp -d /tmp/script.XXXXXX)
trap 'rm -rf -- "$tmpdir"' EXIT

src=$gitdir/opnsense/"$1".xml

mkdir $tmpdir/conf
cp "$src" $tmpdir/conf/config.xml || die "Copy config $src failed"

genisoimage -allow-lowercase -o iso/router.iso $tmpdir
