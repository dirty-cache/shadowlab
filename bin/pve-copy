#!/bin/bash

die() { echo "$(basename $0): [die] $@" >&2 ; exit 1 ; }

gitdir=$(git rev-parse --show-toplevel)

source $gitdir/config/.env

test -z $PVEHOST && die "pvehost not set"

rsync -ai $gitdir/proxmox/bin/* root@${PVEHOST}:/usr/local/bin/
rsync -ai $gitdir/proxmox/etc/* root@${PVEHOST}:/usr/local/etc/