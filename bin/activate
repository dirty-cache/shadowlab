#!/bin/bash

gitdir=$(git rev-parse --show-toplevel)

pathmunge () {
    case ":${PATH}:" in
        *:"$1":*)
            ;;
        *)
            if [ "$2" = "after" ] ; then
                PATH=$PATH:$1
            else
                PATH=$1:$PATH
            fi
    esac
}

pathmunge $gitdir/bin

alias cdshadow='cd $gitdir'
