#!/bin/bash

set -o pipefail 
die() { echo "$(basename $0): [die] $@" >&2 ; exit 1 ; }

[ -n "$1" ] || die "no name provided"
command -v mcopy >/dev/null || die "mcopy not found (install mtools)"

cd $(dirname $BASH_SOURCE)

gitdir=$(git rev-parse --show-toplevel)
oemdisk=$gitdir/iso/"$1".img

rm -f $oemdisk
dd if=/dev/zero of=$oemdisk bs=1M count=8 status=none
mkfs.vfat -n OEMDRV $oemdisk

mcopy -i $oemdisk $gitdir/linux/rootpass.cfg ::rootpass.cfg
mcopy -i $oemdisk $gitdir/linux/kickstart.cfg ::ks.cfg
mcopy -i $oemdisk $gitdir/linux/"$1".cfg ::settings.cfg
#mcopy -i $oemdisk $gitdir/linux/id_ansible.pub ::authorized_keys
mcopy -i $oemdisk $gitdir/linux/shadowlab*.rpm ::shadowlab.rpm
#mcopy -i $oemdisk $gitdir/linux/firstboot-network ::firstboot-network
#mcopy -i $oemdisk $gitdir/linux/firstboot-network.sh ::firstboot-network.sh

mdir -i $oemdisk

ls -al $gitdir/iso
