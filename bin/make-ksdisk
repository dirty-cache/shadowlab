#!/bin/bash

set -o pipefail 
die() { echo "$(basename $0): [die] $@" >&2 ; exit 1 ; }

[ -n "$1" ] || die "no name provided"
command -v mcopy >/dev/null || die "mcopy not found (install mtools)"

cd $(dirname $BASH_SOURCE)

gitdir=$(git rev-parse --show-toplevel)
oemdisk=$gitdir/iso/"$1".img.raw

rm -f $oemdisk
dd if=/dev/zero of=$oemdisk bs=1M count=8 status=none
mkfs.vfat -n OEMDRV $oemdisk

mcopy -i $oemdisk $gitdir/kickstart/rootpass.cfg ::rootpass.cfg
mcopy -i $oemdisk $gitdir/kickstart/kickstart.cfg ::ks.cfg
mcopy -i $oemdisk $gitdir/kickstart/shadowlab.tar.gz ::shadowlab.tar.gz
mcopy -i $oemdisk $gitdir/kickstart/"$1".cfg ::settings.cfg

echo contents:

mdir -b -i $oemdisk

echo

ls -al $gitdir/iso
